{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["packages/**/*.mjs", "modules/**/*.mjs", "scripts/**/*.mjs", "release/**/*.mjs"],
  "exclude": ["**/node_modules/**", "vendor/**", "**/fixtures/**", "release/dist/**"]
}
