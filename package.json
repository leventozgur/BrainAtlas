{
  "name": "brainatlas-monorepo",
  "version": "0.1.0-rc.7",
  "private": true,
  "description": "BrainAtlas — evidence-first memory for coding agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "packages/hooks",
    "packages/cli",
    "packages/adapters/*",
    "modules/*",
    "vendor/llmwiki-core"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "guard": "node scripts/guard.mjs",
    "build:release": "node release/build-release.mjs",
    "eval": "node eval/run-eval.mjs --json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leventozgur/BrainAtlas.git"
  },
  "homepage": "https://github.com/leventozgur/BrainAtlas",
  "bugs": {
    "url": "https://github.com/leventozgur/BrainAtlas/issues"
  }
}
