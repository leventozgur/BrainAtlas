{
  "name": "brainatlas-monorepo",
  "version": "0.1.0-rc.13",
  "private": true,
  "description": "BrainAtlas — evidence-first memory for coding agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "packages/hooks",
    "packages/cli",
    "packages/adapters/*",
    "modules/*",
    "vendor/llmwiki-core"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:perf": "node scripts/run-tests.mjs perf",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write \"**/*.{mjs,js}\"",
    "format:check": "prettier --check \"**/*.{mjs,js}\"",
    "guard": "node scripts/guard.mjs",
    "build:release": "node release/build-release.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "eval": "node eval/run-eval.mjs --json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leventozgur/BrainAtlas.git"
  },
  "homepage": "https://github.com/leventozgur/BrainAtlas",
  "bugs": {
    "url": "https://github.com/leventozgur/BrainAtlas/issues"
  }
}
